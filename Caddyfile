# Railpack v0.40.1 PHP Caddyfile (MIT) with root fixed to /app/public and the log level
# from CADDY_LOG_LEVEL (Railpack ships DEBUG).
{
	admin off
	persist_config off
	auto_https off

  {$CADDY_GLOBAL_OPTIONS}

  log {
    format json
    output stderr
    level {$CADDY_LOG_LEVEL:DEBUG}
  }

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

:{$PORT:80} {

    root * /app/public

	encode zstd br gzip

	file_server {
		hide .git
		hide .env*
	}

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server
}
